<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetCable.Desktop.ViewModels.Tools"
             xmlns:controls="using:NetCable.Desktop.Controls"
             x:Class="NetCable.Desktop.Views.Tools.SubnetView"
             x:DataType="vm:SubnetViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,*">
    <Border Grid.Row="0" Classes="card">
      <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <StackPanel Width="300">
            <TextBlock Text="IP / CIDR / 掩码" FontSize="11" Classes="muted" Margin="0,0,0,4" />
            <TextBox Text="{Binding Input}" Watermark="192.168.1.0/24 或 10.0.0.5/255.255.255.0" />
          </StackPanel>
          <Button Classes="primary" Content="计算" Command="{Binding ComputeCommand}" VerticalAlignment="Bottom" />
        </StackPanel>
        <TextBlock Text="{Binding Summary}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" Foreground="#34D399" />
      </StackPanel>
    </Border>
    <Border Grid.Row="1" Margin="0,12,0,0" Classes="card">
      <controls:ResultTable Rows="{Binding Rows}" KeyHeader="项目" ValueHeader="结果" ExtraHeader="" />
    </Border>
    <Border Grid.Row="3" Margin="0,12,0,0" Classes="card" Padding="12">
      <controls:LogView Logs="{Binding Log}" />
    </Border>
  </Grid>
</UserControl>
