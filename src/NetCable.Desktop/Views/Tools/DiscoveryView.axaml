<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetCable.Desktop.ViewModels.Tools"
             xmlns:controls="using:NetCable.Desktop.Controls"
             x:Class="NetCable.Desktop.Views.Tools.DiscoveryView"
             x:DataType="vm:DiscoveryViewModel">
  <Grid RowDefinitions="Auto,Auto,*">
    <Border Grid.Row="0" Classes="card">
      <StackPanel Spacing="10">
        <WrapPanel Orientation="Horizontal">
          <StackPanel Width="160" Margin="0,0,12,8">
            <TextBlock Text="监听时长" FontSize="11" Classes="muted" Margin="0,0,0,4" />
            <ComboBox ItemsSource="{Binding Durations}" SelectedItem="{Binding SelectedDuration}" />
          </StackPanel>
          <Button Classes="primary" Content="开始监听" Command="{Binding StartCaptureCommand}"
                  IsEnabled="{Binding !IsRunning}" VerticalAlignment="Bottom" Margin="0,0,10,8" />
          <Button Classes="ghost" Content="停止" Command="{Binding CancelCommand}"
                  IsEnabled="{Binding IsRunning}" VerticalAlignment="Bottom" Margin="0,0,14,8" />
          <TextBlock Text="{Binding StatusText}" Classes="muted" FontSize="12"
                     VerticalAlignment="Center" Margin="0,0,0,8" />
        </WrapPanel>
        <TextBlock Text="被动监听 LLDP (EtherType 0x88CC) 与 CDP（SNAP 0x2000），不会向网络发送任何报文。"
                   FontSize="11" Classes="dim" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Margin="0,12,0,0" Classes="card" Padding="12">
      <TextBlock Text="{Binding Summary}" FontFamily="Cascadia Mono, Consolas, monospace"
                 FontSize="12" Foreground="#34D399" TextWrapping="Wrap" />
    </Border>

    <Border Grid.Row="2" Margin="0,12,0,0" Classes="card" Padding="12">
      <Grid RowDefinitions="*,Auto">
        <controls:ResultTable Rows="{Binding Rows}" KeyHeader="{Binding KeyHeader}"
                              ValueHeader="{Binding ValueHeader}" ExtraHeader="{Binding ExtraHeader}" />
        <Border Grid.Row="1" Height="150" Margin="0,10,0,0">
          <controls:LogView Logs="{Binding Log}" />
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
