<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetCable.Desktop.ViewModels.Tools"
             xmlns:controls="using:NetCable.Desktop.Controls"
             x:Class="NetCable.Desktop.Views.Tools.PowerShellView"
             x:DataType="vm:PowerShellViewModel">
  <Grid RowDefinitions="Auto,Auto,*">
    <Border Grid.Row="0" Classes="card">
      <StackPanel Spacing="10">
        <WrapPanel Orientation="Horizontal">
          <StackPanel Width="280" Margin="0,0,12,8">
            <TextBlock Text="目标主机（可留空 = 本机）" FontSize="11" Classes="muted" Margin="0,0,0,4" />
            <TextBox Text="{Binding Target}" Watermark="留空则在本机打开 PowerShell" />
          </StackPanel>
          <StackPanel Width="360" Margin="0,0,12,8">
            <TextBlock Text="命令参数（-Command，可留空）" FontSize="11" Classes="muted" Margin="0,0,0,4" />
            <TextBox Text="{Binding Arguments}" Watermark="Get-NetIPConfiguration" />
          </StackPanel>
        </WrapPanel>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="ghost" Content="生成命令" Command="{Binding RunCommand}" IsEnabled="{Binding !IsRunning}" />
          <Button Classes="ghost" Content="复制命令" Command="{Binding CopyCommand}" />
          <Button Classes="primary" Content="启动" Command="{Binding LaunchCommand}" IsEnabled="{Binding ClientAvailable}" />
          <Button Classes="ghost" Content="停止" Command="{Binding CancelCommand}" IsEnabled="{Binding IsRunning}" />
          <TextBlock Text="{Binding StatusText}" Classes="muted" VerticalAlignment="Center" FontSize="12" />
        </StackPanel>
        <TextBlock Text="{Binding Notice}" FontSize="11" Classes="muted" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Margin="0,12,0,0" Classes="card" Padding="12">
      <StackPanel Spacing="8">
        <TextBlock Text="客户端可用性" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
        <controls:ResultTable Rows="{Binding Rows}" KeyHeader="客户端" ValueHeader="状态"
                              ExtraHeader="可执行文件 / 说明" />
        <TextBlock Text="将执行的命令" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,6,0,0" />
        <TextBox Text="{Binding Command}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                 FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12"
                 Background="#0E1626" BorderThickness="0" MinHeight="34" MaxHeight="90" />
        <TextBlock Text="{Binding CommandHint}" FontSize="11" Classes="dim" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Margin="0,12,0,0" Classes="card" Padding="12">
      <controls:LogView Logs="{Binding Log}" />
    </Border>
  </Grid>
</UserControl>
