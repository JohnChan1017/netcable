<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetCable.Desktop.ViewModels.Tools"
             xmlns:controls="using:NetCable.Desktop.Controls"
             x:Class="NetCable.Desktop.Views.Tools.WolView"
             x:DataType="vm:WolViewModel">
  <Grid RowDefinitions="Auto,Auto,*">
    <Border Grid.Row="0" Classes="card">
      <StackPanel Spacing="10">
        <WrapPanel Orientation="Horizontal">
          <StackPanel Width="240" Margin="0,0,12,8">
            <TextBlock Text="目标 MAC" FontSize="11" Classes="muted" Margin="0,0,0,4" />
            <TextBox Text="{Binding MacAddress}" Watermark="3C:5A:B4:11:22:33" />
          </StackPanel>
          <StackPanel Width="200" Margin="0,0,12,8">
            <TextBlock Text="广播地址" FontSize="11" Classes="muted" Margin="0,0,0,4" />
            <TextBox Text="{Binding BroadcastAddress}" Watermark="255.255.255.255" />
          </StackPanel>
          <StackPanel Width="120" Margin="0,0,12,8">
            <TextBlock Text="端口" FontSize="11" Classes="muted" Margin="0,0,0,4" />
            <NumericUpDown Value="{Binding Port}" Minimum="1" Maximum="65535" Increment="1"
                           ShowButtonSpinner="False" />
          </StackPanel>
        </WrapPanel>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="primary" Content="唤醒" Command="{Binding RunCommand}" IsEnabled="{Binding !IsRunning}" />
          <Button Classes="ghost" Content="停止" Command="{Binding CancelCommand}" IsEnabled="{Binding IsRunning}" />
          <TextBlock Text="{Binding StatusText}" Classes="muted" VerticalAlignment="Center" FontSize="12" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Margin="0,12,0,0" Classes="card" Padding="12">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding Summary}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12"
                   Foreground="#34D399" TextWrapping="Wrap" />
        <TextBlock Text="魔术包 = 6 字节 0xFF + 目标 MAC 重复 16 次，通过 UDP 广播发送；目标设备需在 BIOS/网卡中开启 Wake on LAN，且与本机处于同一广播域或已配置定向广播。"
                   FontSize="11" Classes="dim" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Margin="0,12,0,0" Classes="card" Padding="12">
      <controls:LogView Logs="{Binding Log}" />
    </Border>
  </Grid>
</UserControl>
