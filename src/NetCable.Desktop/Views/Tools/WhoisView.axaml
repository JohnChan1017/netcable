<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetCable.Desktop.ViewModels.Tools"
             xmlns:controls="using:NetCable.Desktop.Controls"
             x:Class="NetCable.Desktop.Views.Tools.WhoisView"
             x:DataType="vm:WhoisViewModel">
  <Grid RowDefinitions="Auto,Auto,*">
    <Border Grid.Row="0" Classes="card">
      <StackPanel Spacing="10">
        <WrapPanel Orientation="Horizontal">
          <StackPanel Width="300" Margin="0,0,12,8">
            <TextBlock Text="域名 / IP" FontSize="11" Classes="muted" Margin="0,0,0,4" />
            <TextBox Text="{Binding Query}" Watermark="example.com 或 8.8.8.8" />
          </StackPanel>
          <StackPanel Width="220" Margin="0,0,12,8">
            <TextBlock Text="Whois 服务器（可选）" FontSize="11" Classes="muted" Margin="0,0,0,4" />
            <TextBox Text="{Binding Server}" Watermark="留空自动跟随 IANA referral" />
          </StackPanel>
          <StackPanel Width="120" Margin="0,0,12,8">
            <TextBlock Text="超时 (ms)" FontSize="11" Classes="muted" Margin="0,0,0,4" />
            <NumericUpDown Value="{Binding Timeout}" Minimum="1000" Maximum="30000" Increment="1000"
                           ShowButtonSpinner="False" />
          </StackPanel>
        </WrapPanel>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="primary" Content="查询" Command="{Binding RunCommand}" IsEnabled="{Binding !IsRunning}" />
          <Button Classes="ghost" Content="停止" Command="{Binding CancelCommand}" IsEnabled="{Binding IsRunning}" />
          <TextBlock Text="{Binding StatusText}" Classes="muted" VerticalAlignment="Center" FontSize="12" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Margin="0,12,0,0" Classes="card" Padding="12">
      <TextBlock Text="{Binding Summary}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12"
                 Foreground="#34D399" TextWrapping="Wrap" />
    </Border>

    <Grid Grid.Row="2" Margin="0,12,0,0" ColumnDefinitions="*,*">
      <Border Grid.Column="0" Classes="card" Padding="12" Margin="0,0,6,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="解析字段" FontSize="11" FontWeight="SemiBold"
                     Foreground="#94A3B8" Margin="0,0,0,8" />
          <controls:ResultTable Rows="{Binding Rows}" KeyHeader="字段" ValueHeader="值" ExtraHeader="" />
        </DockPanel>
      </Border>
      <Border Grid.Column="1" Classes="card" Padding="12" Margin="6,0,0,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="原始响应（只读）" FontSize="11" FontWeight="SemiBold"
                     Foreground="#94A3B8" Margin="0,0,0,8" />
          <TextBox Text="{Binding Raw}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                   FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11"
                   ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   Background="#0E1626" BorderThickness="0" MinHeight="180" />
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
