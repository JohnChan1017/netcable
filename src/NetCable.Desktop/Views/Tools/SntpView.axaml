<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetCable.Desktop.ViewModels.Tools"
             xmlns:controls="using:NetCable.Desktop.Controls"
             x:Class="NetCable.Desktop.Views.Tools.SntpView"
             x:DataType="vm:SntpViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,*">
    <Border Grid.Row="0" Classes="card">
      <StackPanel Spacing="10">
        <WrapPanel Orientation="Horizontal">
          <StackPanel Width="320" Margin="0,0,12,8">
            <TextBlock Text="NTP 服务器" FontSize="11" Classes="muted" Margin="0,0,0,4" />
            <TextBox Text="{Binding Server}" Watermark="pool.ntp.org" />
          </StackPanel>
          <StackPanel Width="130" Margin="0,0,12,8">
            <TextBlock Text="超时 (ms)" FontSize="11" Classes="muted" Margin="0,0,0,4" />
            <NumericUpDown Value="{Binding Timeout}" Minimum="500" Maximum="15000" Increment="500"
                           ShowButtonSpinner="False" />
          </StackPanel>
        </WrapPanel>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="primary" Content="同步" Command="{Binding RunCommand}" IsEnabled="{Binding !IsRunning}" />
          <Button Classes="ghost" Content="停止" Command="{Binding CancelCommand}" IsEnabled="{Binding IsRunning}" />
          <TextBlock Text="{Binding StatusText}" Classes="muted" VerticalAlignment="Center" FontSize="12" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Margin="0,12,0,0" Classes="card" Padding="12">
      <TextBlock Text="{Binding Summary}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12"
                 Foreground="#34D399" TextWrapping="Wrap" />
    </Border>

    <Border Grid.Row="2" Margin="0,12,0,0" Classes="card" Padding="12">
      <controls:ResultTable Rows="{Binding Rows}" KeyHeader="项目" ValueHeader="结果" ExtraHeader="" />
    </Border>

    <Border Grid.Row="3" Margin="0,12,0,0" Classes="card" Padding="12">
      <controls:LogView Logs="{Binding Log}" />
    </Border>
  </Grid>
</UserControl>
