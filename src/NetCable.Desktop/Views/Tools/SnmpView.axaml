<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetCable.Desktop.ViewModels.Tools"
             xmlns:controls="using:NetCable.Desktop.Controls"
             x:Class="NetCable.Desktop.Views.Tools.SnmpView"
             x:DataType="vm:SnmpViewModel">
  <Grid RowDefinitions="Auto,Auto,*">
    <Border Grid.Row="0" Classes="card">
      <StackPanel Spacing="10">
        <WrapPanel Orientation="Horizontal">
          <StackPanel Width="200" Margin="0,0,12,8">
            <TextBlock Text="设备地址" FontSize="11" Classes="muted" Margin="0,0,0,4" />
            <TextBox Text="{Binding Host}" Watermark="192.168.1.1" />
          </StackPanel>
          <StackPanel Width="130" Margin="0,0,12,8">
            <TextBlock Text="Community" FontSize="11" Classes="muted" Margin="0,0,0,4" />
            <TextBox Text="{Binding Community}" Watermark="public" />
          </StackPanel>
          <StackPanel Width="100" Margin="0,0,12,8">
            <TextBlock Text="版本" FontSize="11" Classes="muted" Margin="0,0,0,4" />
            <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" />
          </StackPanel>
          <StackPanel Width="210" Margin="0,0,12,8">
            <TextBlock Text="OID" FontSize="11" Classes="muted" Margin="0,0,0,4" />
            <TextBox Text="{Binding Oid}" Watermark="1.3.6.1.2.1.1.1.0" />
          </StackPanel>
          <StackPanel Width="130" Margin="0,0,12,8">
            <TextBlock Text="超时 (ms)" FontSize="11" Classes="muted" Margin="0,0,0,4" />
            <NumericUpDown Value="{Binding Timeout}" Minimum="200" Maximum="30000" Increment="500" ShowButtonSpinner="False" />
          </StackPanel>
        </WrapPanel>

        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="primary" Content="GET" Command="{Binding StartGetCommand}"
                  IsEnabled="{Binding !IsRunning}" />
          <Button Classes="ghost" Content="WALK" Command="{Binding StartWalkCommand}"
                  IsEnabled="{Binding !IsRunning}" />
          <Button Classes="ghost" Content="停止" Command="{Binding CancelCommand}"
                  IsEnabled="{Binding IsRunning}" />
          <TextBlock Text="{Binding StatusText}" Classes="muted" VerticalAlignment="Center" FontSize="12" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Margin="0,12,0,0" Classes="card" Padding="12">
      <TextBlock Text="{Binding Summary}" FontFamily="Cascadia Mono, Consolas, monospace"
                 FontSize="12" Foreground="#34D399" TextWrapping="Wrap" />
    </Border>

    <Border Grid.Row="2" Margin="0,12,0,0" Classes="card" Padding="12">
      <Grid RowDefinitions="*,Auto">
        <controls:ResultTable Rows="{Binding Rows}" KeyHeader="OID" ValueHeader="值" ExtraHeader="类型" />
        <Border Grid.Row="1" Height="150" Margin="0,10,0,0">
          <controls:LogView Logs="{Binding Log}" />
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
