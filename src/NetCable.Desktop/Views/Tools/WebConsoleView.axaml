<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetCable.Desktop.ViewModels.Tools"
             xmlns:controls="using:NetCable.Desktop.Controls"
             x:Class="NetCable.Desktop.Views.Tools.WebConsoleView"
             x:DataType="vm:WebConsoleViewModel">
  <Grid RowDefinitions="Auto,Auto,*">
    <Border Grid.Row="0" Classes="card">
      <StackPanel Spacing="10">
        <WrapPanel Orientation="Horizontal">
          <StackPanel Width="460" Margin="0,0,12,8">
            <TextBlock Text="设备管理页 URL" FontSize="11" Classes="muted" Margin="0,0,0,4" />
            <TextBox Text="{Binding Url}" Watermark="http://192.168.1.1" />
          </StackPanel>
        </WrapPanel>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="ghost" Content="预览命令" Command="{Binding RunCommand}" IsEnabled="{Binding !IsRunning}" />
          <Button Classes="ghost" Content="复制网址" Command="{Binding CopyUrlCommand}" />
          <Button Classes="primary" Content="用系统浏览器打开" Command="{Binding OpenBrowserCommand}" />
          <Button Classes="ghost" Content="停止" Command="{Binding CancelCommand}" IsEnabled="{Binding IsRunning}" />
          <TextBlock Text="{Binding StatusText}" Classes="muted" VerticalAlignment="Center" FontSize="12" />
        </StackPanel>
        <TextBlock Text="{Binding Notice}" FontSize="11" Classes="dim" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Margin="0,12,0,0" Classes="card" Padding="12">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding Summary}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12"
                   Foreground="#34D399" TextWrapping="Wrap" />
        <controls:ResultTable Rows="{Binding Rows}" KeyHeader="项目" ValueHeader="结果" ExtraHeader="" />
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Margin="0,12,0,0" Classes="card" Padding="12">
      <controls:LogView Logs="{Binding Log}" />
    </Border>
  </Grid>
</UserControl>
