<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetCable.Desktop.ViewModels.Tools"
             xmlns:controls="using:NetCable.Desktop.Controls"
             x:Class="NetCable.Desktop.Views.Tools.TracerouteView"
             x:DataType="vm:TracerouteViewModel">
  <Grid RowDefinitions="Auto,Auto,2*,3*">
    <Border Grid.Row="0" Classes="card">
      <StackPanel Spacing="10">
        <WrapPanel Orientation="Horizontal">
          <StackPanel Width="260" Margin="0,0,12,8">
            <TextBlock Text="目标主机 / IP" FontSize="11" Classes="muted" Margin="0,0,0,4" />
            <TextBox Text="{Binding Host}" Watermark="example.com 或 223.5.5.5" />
          </StackPanel>
          <StackPanel Width="110" Margin="0,0,12,8">
            <TextBlock Text="最大跳数" FontSize="11" Classes="muted" Margin="0,0,0,4" />
            <NumericUpDown Value="{Binding MaxHops}" Minimum="1" Maximum="64" Increment="1" ShowButtonSpinner="False" />
          </StackPanel>
          <StackPanel Width="130" Margin="0,0,12,8">
            <TextBlock Text="超时 (ms)" FontSize="11" Classes="muted" Margin="0,0,0,4" />
            <NumericUpDown Value="{Binding Timeout}" Minimum="200" Maximum="10000" Increment="100" ShowButtonSpinner="False" />
          </StackPanel>
          <StackPanel Width="120" Margin="0,0,12,8">
            <TextBlock Text="每跳探测次数" FontSize="11" Classes="muted" Margin="0,0,0,4" />
            <NumericUpDown Value="{Binding Probes}" Minimum="1" Maximum="5" Increment="1" ShowButtonSpinner="False" />
          </StackPanel>
          <CheckBox Content="反向解析主机名" IsChecked="{Binding ResolveHostNames}"
                    VerticalAlignment="Bottom" Margin="0,0,12,12" />
        </WrapPanel>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="primary" Content="开始追踪" Command="{Binding RunCommand}" IsEnabled="{Binding !IsRunning}" />
          <Button Classes="ghost" Content="停止" Command="{Binding CancelCommand}" IsEnabled="{Binding IsRunning}" />
          <TextBlock Text="{Binding StatusText}" Classes="muted" VerticalAlignment="Center" FontSize="12" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Margin="0,12,0,0" Classes="card" Padding="12">
      <TextBlock Text="{Binding Summary}" FontFamily="Cascadia Mono, Consolas, monospace"
                 FontSize="12" Foreground="#34D399" TextWrapping="Wrap" />
    </Border>

    <Border Grid.Row="2" Margin="0,12,0,0" Classes="card" Padding="12">
      <controls:ResultTable Rows="{Binding Rows}" KeyHeader="跳" ValueHeader="地址" ExtraHeader="RTT · 主机名" />
    </Border>

    <Border Grid.Row="3" Margin="0,12,0,0" Classes="card" Padding="12">
      <controls:LogView Logs="{Binding Log}" />
    </Border>
  </Grid>
</UserControl>
