<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetCable.Desktop.ViewModels.Tools"
             xmlns:controls="using:NetCable.Desktop.Controls"
             x:Class="NetCable.Desktop.Views.Tools.BitCalcView"
             x:DataType="vm:BitCalcViewModel">
  <Grid RowDefinitions="Auto,Auto,*">
    <Border Grid.Row="0" Classes="card">
      <StackPanel Spacing="12">
        <WrapPanel Orientation="Horizontal">
          <StackPanel Width="280" Margin="0,0,12,8">
            <TextBlock Text="数值（十进制 / 0x / 0b / 0o）" FontSize="11" Classes="muted" Margin="0,0,0,4" />
            <TextBox Text="{Binding Input}" Watermark="255 或 0xFF 或 0b11111111 或 0o377" />
          </StackPanel>
          <Button Classes="primary" Content="转换" Command="{Binding RunCommand}"
                  IsEnabled="{Binding !IsRunning}" VerticalAlignment="Bottom" Margin="0,0,10,8" />
          <TextBlock Text="{Binding StatusText}" Classes="muted" FontSize="12"
                     VerticalAlignment="Center" Margin="0,0,0,8" />
        </WrapPanel>

        <Border Height="1" Background="#22304A" />

        <WrapPanel Orientation="Horizontal">
          <StackPanel Width="120" Margin="0,0,12,8">
            <TextBlock Text="位运算" FontSize="11" Classes="muted" Margin="0,0,0,4" />
            <ComboBox ItemsSource="{Binding Operators}" SelectedItem="{Binding SelectedOperator}" />
          </StackPanel>
          <StackPanel Width="150" Margin="0,0,12,8">
            <TextBlock Text="操作数 A" FontSize="11" Classes="muted" Margin="0,0,0,4" />
            <TextBox Text="{Binding OperandA}" Watermark="0b1010" />
          </StackPanel>
          <StackPanel Width="150" Margin="0,0,12,8">
            <TextBlock Text="操作数 B" FontSize="11" Classes="muted" Margin="0,0,0,4" />
            <TextBox Text="{Binding OperandB}" Watermark="0b0110 / 左移位数" />
          </StackPanel>
          <Button Classes="ghost" Content="计算位运算" Command="{Binding ComputeBinaryCommand}"
                  VerticalAlignment="Bottom" Margin="0,0,12,8" />
          <TextBlock Text="左移 / 右移时操作数 B 为位移位数" FontSize="11" Classes="dim"
                     VerticalAlignment="Bottom" Margin="0,0,0,12" />
        </WrapPanel>
        <TextBlock Text="{Binding BinarySummary}" FontFamily="Cascadia Mono, Consolas, monospace"
                   FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Margin="0,12,0,0" Classes="card" Padding="12">
      <TextBlock Text="{Binding Summary}" FontFamily="Cascadia Mono, Consolas, monospace"
                 FontSize="12" Foreground="#34D399" TextWrapping="Wrap" />
    </Border>

    <Border Grid.Row="2" Margin="0,12,0,0" Classes="card" Padding="12">
      <Grid RowDefinitions="*,Auto">
        <controls:ResultTable Rows="{Binding Rows}" KeyHeader="进制 / 项目" ValueHeader="结果" ExtraHeader="备注" />
        <Border Grid.Row="1" Height="150" Margin="0,10,0,0">
          <controls:LogView Logs="{Binding Log}" />
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
