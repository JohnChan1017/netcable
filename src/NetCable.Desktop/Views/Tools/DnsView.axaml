<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetCable.Desktop.ViewModels.Tools"
             xmlns:controls="using:NetCable.Desktop.Controls"
             x:Class="NetCable.Desktop.Views.Tools.DnsView"
             x:DataType="vm:DnsViewModel">
  <Grid RowDefinitions="Auto,Auto,*">
    <Border Grid.Row="0" Classes="card">
      <StackPanel Spacing="10">
        <WrapPanel Orientation="Horizontal">
          <StackPanel Width="280" Margin="0,0,12,8">
            <TextBlock Text="域名 / 主机" FontSize="11" Classes="muted" Margin="0,0,0,4" />
            <TextBox Text="{Binding Name}" Watermark="example.com" />
          </StackPanel>
          <StackPanel Width="130" Margin="0,0,12,8">
            <TextBlock Text="记录类型" FontSize="11" Classes="muted" Margin="0,0,0,4" />
            <ComboBox ItemsSource="{Binding RecordTypes}" SelectedItem="{Binding SelectedRecordType}"
                      HorizontalAlignment="Stretch" />
          </StackPanel>
          <StackPanel Width="200" Margin="0,0,12,8">
            <TextBlock Text="DNS 服务器（可选）" FontSize="11" Classes="muted" Margin="0,0,0,4" />
            <TextBox Text="{Binding Server}" Watermark="留空用系统 DNS，如 8.8.8.8" />
          </StackPanel>
          <StackPanel Width="120" Margin="0,0,12,8">
            <TextBlock Text="超时 (ms)" FontSize="11" Classes="muted" Margin="0,0,0,4" />
            <NumericUpDown Value="{Binding Timeout}" Minimum="500" Maximum="15000" Increment="500"
                           ShowButtonSpinner="False" />
          </StackPanel>
        </WrapPanel>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="primary" Content="查询" Command="{Binding RunCommand}" IsEnabled="{Binding !IsRunning}" />
          <Button Classes="ghost" Content="停止" Command="{Binding CancelCommand}" IsEnabled="{Binding IsRunning}" />
          <TextBlock Text="{Binding StatusText}" Classes="muted" VerticalAlignment="Center" FontSize="12" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Margin="0,12,0,0" Classes="card" Padding="12">
      <TextBlock Text="{Binding Summary}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12"
                 Foreground="#34D399" TextWrapping="Wrap" />
    </Border>

    <Border Grid.Row="2" Margin="0,12,0,0" Classes="card" Padding="12">
      <controls:ResultTable Rows="{Binding Rows}" KeyHeader="名称" ValueHeader="值" ExtraHeader="类型 · TTL" />
    </Border>
  </Grid>
</UserControl>
