<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetCable.Desktop.ViewModels.Tools"
             xmlns:controls="using:NetCable.Desktop.Controls"
             x:Class="NetCable.Desktop.Views.Tools.PortScanView"
             x:DataType="vm:PortScanViewModel">
  <Grid RowDefinitions="Auto,Auto,*">
    <Border Grid.Row="0" Classes="card">
      <StackPanel Spacing="10">
        <WrapPanel Orientation="Horizontal">
          <StackPanel Width="240" Margin="0,0,12,8">
            <TextBlock Text="目标主机 / IP" FontSize="11" Classes="muted" Margin="0,0,0,4" />
            <TextBox Text="{Binding Host}" Watermark="127.0.0.1 或 192.168.1.1" />
          </StackPanel>
          <StackPanel Width="200" Margin="0,0,12,8">
            <TextBlock Text="端口段" FontSize="11" Classes="muted" Margin="0,0,0,4" />
            <TextBox Text="{Binding PortRange}" Watermark="1-1024 或 22,80,443" />
          </StackPanel>
          <StackPanel Width="130" Margin="0,0,12,8">
            <TextBlock Text="并发数" FontSize="11" Classes="muted" Margin="0,0,0,4" />
            <NumericUpDown Value="{Binding Concurrency}" Minimum="1" Maximum="1024" Increment="32" ShowButtonSpinner="False" />
          </StackPanel>
          <StackPanel Width="130" Margin="0,0,12,8">
            <TextBlock Text="超时 (ms)" FontSize="11" Classes="muted" Margin="0,0,0,4" />
            <NumericUpDown Value="{Binding Timeout}" Minimum="100" Maximum="10000" Increment="100" ShowButtonSpinner="False" />
          </StackPanel>
        </WrapPanel>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="primary" Content="开始扫描" Command="{Binding RunCommand}" IsEnabled="{Binding !IsRunning}" />
          <Button Classes="ghost" Content="停止" Command="{Binding CancelCommand}" IsEnabled="{Binding IsRunning}" />
          <TextBlock Text="{Binding StatusText}" Classes="muted" VerticalAlignment="Center" FontSize="12" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Margin="0,12,0,0" Classes="card" Padding="12">
      <TextBlock Text="{Binding Summary}" FontFamily="Cascadia Mono, Consolas, monospace"
                 FontSize="12" Foreground="#34D399" TextWrapping="Wrap" />
    </Border>

    <Border Grid.Row="2" Margin="0,12,0,0" Classes="card" Padding="12">
      <Grid RowDefinitions="*,Auto">
        <controls:ResultTable Rows="{Binding Rows}" KeyHeader="端口" ValueHeader="服务" ExtraHeader="延迟 · Banner" />
        <Border Grid.Row="1" Height="150" Margin="0,10,0,0">
          <controls:LogView Logs="{Binding Log}" />
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
