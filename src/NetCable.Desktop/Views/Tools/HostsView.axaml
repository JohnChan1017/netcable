<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetCable.Desktop.ViewModels.Tools"
             xmlns:controls="using:NetCable.Desktop.Controls"
             x:Class="NetCable.Desktop.Views.Tools.HostsView"
             x:DataType="vm:HostsViewModel">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Classes="card">
      <StackPanel Spacing="10">
        <WrapPanel Orientation="Horizontal">
          <StackPanel Width="430" Margin="0,0,16,8">
            <TextBlock Text="hosts 文件路径" FontSize="11" Classes="muted" Margin="0,0,0,4" />
            <TextBlock Text="{Binding FilePath}" FontFamily="Cascadia Mono, Consolas, monospace"
                       FontSize="12" Foreground="#E2E8F0" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Width="360" Margin="0,0,0,8" VerticalAlignment="Bottom">
            <TextBlock Text="{Binding Summary}" FontFamily="Cascadia Mono, Consolas, monospace"
                       FontSize="12" Foreground="#34D399" TextWrapping="Wrap" />
          </StackPanel>
        </WrapPanel>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="primary" Content="重新读取" Command="{Binding RunCommand}" IsEnabled="{Binding !IsRunning}" />
          <Button Classes="ghost" Content="保存" Command="{Binding SaveCommand}" IsEnabled="{Binding CanWrite}" />
          <Button Classes="ghost" Content="停止" Command="{Binding CancelCommand}" IsEnabled="{Binding IsRunning}" />
          <TextBlock Text="{Binding StatusText}" Classes="muted" VerticalAlignment="Center" FontSize="12" />
        </StackPanel>
        <TextBlock Text="{Binding Notice}" FontSize="11" Foreground="#F59E0B" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" Margin="0,12,0,0" ColumnDefinitions="3*,2*">
      <Border Grid.Column="0" Classes="card" Padding="12" Margin="0,0,6,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="条目列表" FontSize="11" FontWeight="SemiBold"
                     Foreground="#94A3B8" />
          <Grid DockPanel.Dock="Top" ColumnDefinitions="56,150,*,200" Margin="0,8,0,4">
            <TextBlock Grid.Column="0" Text="行号" FontSize="11" Foreground="#94A3B8" />
            <TextBlock Grid.Column="1" Text="IP 地址" FontSize="11" Foreground="#94A3B8" />
            <TextBlock Grid.Column="2" Text="主机名" FontSize="11" Foreground="#94A3B8" />
            <TextBlock Grid.Column="3" Text="注释" FontSize="11" Foreground="#94A3B8" />
          </Grid>
          <Border DockPanel.Dock="Top" Height="1" Background="#22304A" Margin="0,0,0,4" />
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Entries}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HostsRow">
                  <Grid ColumnDefinitions="56,150,*,200" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="{Binding Line}" FontSize="12"
                               FontFamily="Cascadia Mono, Consolas, monospace" Foreground="#64748B" />
                    <TextBlock Grid.Column="1" Text="{Binding IpAddress}" FontSize="12"
                               FontFamily="Cascadia Mono, Consolas, monospace" Foreground="#34D399" />
                    <TextBlock Grid.Column="2" Text="{Binding HostName}" FontSize="12" Foreground="#E2E8F0"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="3" Text="{Binding Comment}" FontSize="12" Foreground="#94A3B8"
                               TextTrimming="CharacterEllipsis" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Border Grid.Column="1" Classes="card" Padding="12" Margin="6,0,0,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="编辑区（IP 主机名 # 注释，每行一条）" FontSize="11"
                     FontWeight="SemiBold" Foreground="#94A3B8" />
          <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" FontSize="11" Classes="dim"
                     TextWrapping="Wrap"
                     Text="保存会重写 hosts 文件（保存前自动备份）；编辑区为规范化条目，纯注释行不保留。" />
          <TextBox Margin="0,8,0,0" Text="{Binding EditText}" AcceptsReturn="True" TextWrapping="NoWrap"
                   FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12"
                   Background="#0E1626" BorderThickness="0"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto" />
        </DockPanel>
      </Border>
    </Grid>

    <Border Grid.Row="2" Margin="0,12,0,0" Classes="card" Padding="12" Height="110">
      <controls:LogView Logs="{Binding Log}" />
    </Border>
  </Grid>
</UserControl>
